# CDIS runtime configuration. Copy to .env and adjust.

# Environment. Set to "production" to enforce production-required settings
# (e.g. JWT_SECRET must be set — boot fails otherwise).
APP_ENV=dev

# SQLite by default (zero setup). Postgres in production:
# DATABASE_URL=postgresql+psycopg://cdis:cdis@db:5432/cdis
DATABASE_URL=sqlite:///./cdis.db

# REQUIRED in production. If unset in dev, a random secret is generated at boot
# (logged as a warning); this invalidates sessions on restart and does not work
# across multiple instances. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_HOURS=24

# Optional. When unset, the deterministic rule engine is primary (all numbers
# always come from it either way — the LLM only rephrases explanations).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# LLM adapter is best-effort and cosmetic: tight timeout, capped transient retries.
LLM_TIMEOUT_S=4.0
LLM_CONNECT_TIMEOUT_S=1.5
LLM_MAX_RETRIES=2

# Rate limiting (per-process token bucket; move to Redis for multi-instance).
RATE_LIMIT_PER_MINUTE=240
# Tighter budget for /api/auth/* to blunt credential brute-forcing.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Enable ONLY behind a trusted proxy/LB so X-Forwarded-For is used for client IP.
TRUST_PROXY_HEADERS=0

# Interactive API docs (/api/docs) + schema. Off in production by default; set to
# 1 to force-enable. Exposing the full API surface is an information disclosure.
# ENABLE_DOCS=0

# Max resume upload size in bytes (default 2 MiB). Text ingest is capped separately.
MAX_UPLOAD_BYTES=2097152

# Structured JSON logs. Defaults on in production, off in dev.
# LOG_JSON=1

# Demo/ops
SIMULATE_LLM_DOWN=0
